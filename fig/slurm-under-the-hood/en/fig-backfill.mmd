%%{init: {"theme": "neutral", "gantt": {"useWidth": 900, "barHeight": 28, "fontSize": 14, "sectionFontSize": 15, "leftPadding": 70}}}%%
gantt
  todayMarker off
  dateFormat HH:mm
  axisFormat %H:%M
  section Node 1
  Job A (running)           :active, a, 00:00, 4h
  Job B (needs 2 nodes)     :crit, b1, 04:00, 2h
  section Node 2
  Job C (backfilled)        :active, c, 00:00, 3h
  Idle                      :done, idle, 03:00, 1h
  Job B (needs 2 nodes)     :crit, b2, 04:00, 2h
